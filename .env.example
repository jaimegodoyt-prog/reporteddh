# Plantilla: copia este archivo a .env y reemplaza los valores.
# Supabase → Dashboard → Project Settings → API
#
# IMPORTANTE: la URL debe incluir el subdominio de tu proyecto, NO https://supabase.co
# Ejemplo correcto: https://abcdefgh.supabase.co

VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu_clave_anon_aqui

# Opcional: para aplicar el esquema automáticamente con npm run db:align
# Dashboard → Project Settings → Database → Database password
# SUPABASE_DB_PASSWORD=tu_password_de_base_de_datos
